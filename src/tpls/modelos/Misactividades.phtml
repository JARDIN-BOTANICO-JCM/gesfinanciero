	const esResponsableIVA = function( d ){
		const datosmes = d['datosmes'];
		const ddones = datosmes['deducciones'];
		
		const valorccobro = datosmes['valorccobro'];
		
		let iva = 0;
		let reteiva = 0;
		
		let responsable = false;
		
		for (const key in ddones) {
    	    if ( Object.hasOwnProperty.call( ddones, key ) ) {
    	        const _el = ddones[key];
    	        
    	        let esiva = false;
    	        if( Object.hasOwnProperty.call( _el, 'esiva' ) ){
    	        	esiva = _el['esiva'];
    	        }
    	        let esreteiva = false;
    	        if( Object.hasOwnProperty.call( _el, 'esreteiva' ) ){
    	        	esreteiva = _el['esreteiva'];
    	        }
    	        
    	        if( esiva == "si" ){
    	        	iva = parseFloat(_el['perc']);
    	        	responsable = true;
    	        }
    	        
    	        if( esreteiva == "si" ){
    	        	reteiva = parseFloat(_el['perc']);
    	        }
	        }
        }
        
        let resultados = [];
        if( responsable ){
        	const porc_despuesiva = iva + parseFloat( 1.0 );
        	const valDespuesIva = valorccobro / porc_despuesiva;
        	
        	const valorBase_fix = parseFloat( valDespuesIva.toFixed(2) );
        	
        	const valIva = parseFloat( valorBase_fix ) * iva;
        	const valIva_fix = parseFloat( valIva.toFixed(2) );
        	
        	const valReveIva = valIva_fix * reteiva;
        	const valReveIva_fix = parseFloat( valReveIva.toFixed(2) );
        	
        	resultados.push( {
        		'base' : valorBase_fix,
        		'iva' : valIva_fix,
        		'reteiva' : valReveIva_fix
        	} );
        }        
        
        return resultados;
	};
	
