            usuariosAsignadosActuales.push({
                id: Number(jQuery(this).val()),
                nombre: jQuery(this).data('nombre')
            });
        });
    
        const idsAsignadosActuales = usuariosAsignadosActuales.map(u => u.id);
        
        // **SEPARAR USUARIOS POR ESTADO ORIGINAL**
        const usuariosOriginalesActivos = _usuariosAsignadosOriginales.filter(u => u.apoyosestados_id === 1);
        const usuariosOriginalesInactivos = _usuariosAsignadosOriginales.filter(u => u.apoyosestados_id === 2);
        
        const idsOriginalesActivos = usuariosOriginalesActivos.map(u => u.id);
        const idsOriginalesInactivos = usuariosOriginalesInactivos.map(u => u.id);

        // **USUARIOS A DESACTIVAR**: Estaban activos (estado 1) pero ya no están seleccionados
        const usuariosADesactivar = usuariosOriginalesActivos.filter(u =>
            !idsAsignadosActuales.includes(u.id)
        );

        // **USUARIOS COMPLETAMENTE NUEVOS**: No estaban en ningún estado anterior
        const usuariosCompletamenteNuevos = usuariosAsignadosActuales.filter(u =>
            !idsOriginalesActivos.includes(u.id) && !idsOriginalesInactivos.includes(u.id)
        );

        // **USUARIOS A REACTIVAR**: Estaban inactivos (estado 2) y ahora están seleccionados
        const usuariosAReactivar = usuariosAsignadosActuales.filter(u =>
            idsOriginalesInactivos.includes(u.id)
        );

        const totalOperaciones = usuariosADesactivar.length + usuariosCompletamenteNuevos.length + usuariosAReactivar.length;

        if (totalOperaciones === 0) {
            alert('No se detectaron cambios en las asignaciones.');
            return;
        }

        const opc = { id: 'ajaxldr' };
        const objmdl = mngModal.dibujar(opc);
        jQuery(objmdl).modal('show');

        let enviados = 0;
        let errores = 0;

        const finalizarOperacion = function () {
            if (enviados + errores === totalOperaciones) {
                setTimeout(() => {
                    jQuery(objmdl).modal('hide');
                    jQuery('#stcMdl_l2').modal('hide');
                    // Recargar datos para mostrar el nuevo estado
                    cargarUsuariosApoyo(supervisorId);
                }, <?php echo IndexCtrl::TIEMPO_AJAX_LDN; ?>);

                const objmdlFinal = mngModal.dibujar({
                    id: 'mdlFinal',
                    title: 'Resultado de la Asignación',
                    btnCerrarX: true,
                    center: true,
                    level: (errores === 0 ? 'scc' : 'err')
                });

                const alerta = jQuery(objmdlFinal + ' div.alert');
                alerta.attr('class', errores === 0 ? 'alert alert-success' : 'alert alert-warning');
                alerta.html(`
                <i class="fe fe-check-circle"></i> 
                Proceso completado. ${enviados} operación(es) exitosa(s) y ${errores} error(es).
            `);

                jQuery(objmdlFinal).modal('show');
            }
        };

        // **1. USUARIOS COMPLETAMENTE NUEVOS (estado 1)**
        usuariosCompletamenteNuevos.forEach((usuario) => {
            const payload = {
                supervisor_id: supervisorId,
                supervisor: supervisorNombre,
                asignado_id: usuario.id,
                asignado: usuario.nombre,
                usuariosmodifica: <?php echo $usu->getId(); ?>,
                apoyosestados_id: 1
            };

            const form_data = new FormData();
            form_data.append('ajax', '<?php echo md5(IndexCtrl::API_ApooyosHelperAdd); ?>');
            form_data.append('data', btoa(JSON.stringify(payload)));

            __TransportarData(
                form_data,
                function success() {
                    enviados++;
                    finalizarOperacion();
                },
                function error(err) {
                    errores++;
                    console.error('Error al agregar usuario nuevo', usuario.nombre, ':', err);
                    finalizarOperacion();
                }
            );
        });

        // **2. USUARIOS A REACTIVAR (estado 2 → 1)**
        usuariosAReactivar.forEach((usuario) => {
            const payload = {
                supervisor_id: supervisorId,
                asignado_id: usuario.id,
                usuariosmodifica: <?php echo $usu->getId(); ?>,
                apoyosestados_id: 1 // Cambiar de 2 a 1
            };

            const form_data = new FormData();
            form_data.append('ajax', '<?php echo md5(IndexCtrl::API_ApooyosHelperAdd); ?>');
            form_data.append('data', btoa(JSON.stringify(payload)));

            __TransportarData(
                form_data,
                function success() {
                    enviados++;
                    finalizarOperacion();
                },
                function error(err) {
                    errores++;
                    console.error('Error al reactivar usuario', usuario.nombre, ':', err);
                    finalizarOperacion();
                }
            );
        });

        // **3. USUARIOS A DESACTIVAR (estado 1 → 2)**
        usuariosADesactivar.forEach((usuario) => {
            const payload = {
                supervisor_id: supervisorId,
                asignado_id: usuario.id, 
                usuariosmodifica: <?php echo $usu->getId(); ?>,
                apoyosestados_id: 2 // Cambiar de 1 a 2
            };

            const form_data = new FormData();
            form_data.append('ajax', '<?php echo md5(IndexCtrl::API_ApooyosHelperAdd); ?>');
            form_data.append('data', btoa(JSON.stringify(payload)));

            __TransportarData(
                form_data,
                function success() {
                    enviados++;
                    finalizarOperacion();
                },
                function error(err) {
                    errores++;
                    console.error('Error al desactivar usuario', usuario.nombre, ':', err);
                    finalizarOperacion();
                }
            );
        });

    };

</script>

