            columnDefs: [
                <?php $idTarget = 0; ?>
            <?php foreach ($columnas as $k => $v): ?>
                {
                        'targets': <?php echo $idTarget; ?>,
                        'createdCell': function (td, cellData, rowData, row, col) {
