            },
            columns: [
                <?php foreach ($columnas as $k => $v): ?>
                { data: '<?php echo $k ?>' },
                <?php endforeach; ?>
            { data: null }
            ],
            dom: 'Bfrtip',
            buttons: _allBtnTb,
            responsive: true,
            language: lengua_es,
            'createdRow': function (row, data, dataIndex) {
                jQuery(row).attr('id', 'r' + data['id']);
