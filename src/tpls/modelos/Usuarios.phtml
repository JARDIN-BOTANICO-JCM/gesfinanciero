    let _usuariosAsignadosOriginales = [];

    /**
     * Carga y muestra los usuarios disponibles y asignados para un supervisor específico.
     * @param {number} supervisorId - ID del supervisor para cargar los usuarios de apoyo.
     * @return {void}
     */
    const cargarUsuariosApoyo = function (supervisorId) {
        jQuery('#lista_usuarios_disponibles').html(

            '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>'

        );
        jQuery('#lista_usuarios_asignados').html(
            '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>'
        );
        const form_data_disponibles = new FormData();

        form_data_disponibles.append('ajax', '<?php echo md5(IndexCtrl::API_UsuariosGetAjax); ?>');

        __TransportarData(
            form_data_disponibles,
            function (dataDisponibles) {
                const form_data_asignados = new FormData();
                form_data_asignados.append('ajax', '<?php echo md5(IndexCtrl::API_ApoyosGet); ?>');
                form_data_asignados.append('supervisor_id', supervisorId);
                __TransportarData(
                    form_data_asignados,
                    function (dataAsignados) {
                        const asignados = Array.isArray(dataAsignados) ? dataAsignados : [];

                        const asignadosNormalizados = asignados.map(a => ({
                            id: Number(a.asignado_id),
                            nombre: a.asignado,
                            asignado_id: Number(a.asignado_id),
                            apoyosestados_id: Number(a.apoyosestados_id || 1)
                        }));

                        _usuariosAsignadosOriginales = asignadosNormalizados;
                        
                        // **FILTRAR SOLO USUARIOS CON ESTADO 1 PARA ASIGNADOS**
                        const asignadosActivos = asignadosNormalizados.filter(a => a.apoyosestados_id === 1);
                        
                        const idsAsignadosActivos = asignadosActivos.map(a => a.id);
                        
                        // **USUARIOS INACTIVOS (ESTADO 2) PARA AGREGAR A DISPONIBLES**
                        const asignadosInactivos = asignadosNormalizados.filter(a => a.apoyosestados_id === 2);
                       
                        const disponiblesNormalizados = (dataDisponibles.data || dataDisponibles).map(u => ({
                            id: Number(u.id),
                            nombre: u.nombres ? `${u.nombres} ${u.apellidos}`.trim() : u.nombre
                        }));
                        
                        // **USUARIOS DISPONIBLES: EXCLUIR ACTIVOS + AGREGAR INACTIVOS**
                        const usuariosDisponibles = disponiblesNormalizados.filter(u =>
                            !idsAsignadosActivos.includes(u.id) && u.id !== Number(supervisorId)
                        );
                        
                        // **AGREGAR USUARIOS INACTIVOS A LA LISTA DE DISPONIBLES**
                        asignadosInactivos.forEach(inactivo => {
                            usuariosDisponibles.push({
                                id: inactivo.id,
                                nombre: inactivo.nombre
                            });
                        });
                        
                        renderizarListaUsuarios(usuariosDisponibles, 'lista_usuarios_disponibles', false);
                        renderizarListaUsuarios(asignadosActivos, 'lista_usuarios_asignados', true);

                    },

                    function (err) {
                        console.warn('No se pudieron cargar usuarios asignados, mostrando todos como disponibles:', err);
                    }

                );

            },

            function (err) {

                console.error('Error al cargar usuarios disponibles:', err);

                jQuery('#lista_usuarios_disponibles').html(

                    '<div class="alert alert-danger">Error al cargar usuarios disponibles: ' + (err.responseText || err.statusText || 'Error desconocido') + '</div>'

                );

                jQuery('#lista_usuarios_asignados').html(

                    '<div class="alert alert-warning">No se pudieron cargar los datos</div>'

                );

            }

        );

    };

    /**
     * Renderiza la lista de usuarios en el contenedor especificado.
     * @param {Array} usuarios - Lista de usuarios a renderizar.
     * @param {string} contenedorId - ID del contenedor donde se mostrará la lista.
     * @param {boolean} checked - Indica si los checkboxes deben estar marcados.
     * @return {void}
     */
    const renderizarListaUsuarios = function (usuarios, contenedorId, checked) {
        const html = [];
        if (usuarios.length === 0) {
            html.push('<div class="text-center py-4 text-muted">');
            html.push('    <i class="fe fe-users fs-1"></i>');
            html.push('    <p>No hay usuarios ' + (checked ? 'asignados' : 'disponibles') + '</p>');
            html.push('</div>');
        } else {
            usuarios.forEach(function (usuario) {
                const fullName = usuario.nombre;
                const checkboxId = 'usuario_' + usuario.id + '_' + contenedorId;

                html.push('<label class="list-group-item d-flex" for="' + checkboxId + '">');
                html.push('    <input class="form-check-input me-2" type="checkbox" ');
                html.push('           id="' + checkboxId + '" ');
                html.push('           value="' + usuario.id + '" ');
                html.push('           data-nombre="' + fullName + '" ');
                if (checked) {
                    html.push('       checked ');
                }
                html.push('           onchange="moverUsuarioApoyo(this, ' + checked + ');">');
                html.push('    <div>');
                html.push('        <strong>' + fullName + '</strong>');
                html.push('    </div>');
                html.push('</label>');
            });
        }

        jQuery('#' + contenedorId).html(html.join(''));
    };

    /**
     * Mueve un usuario entre las listas de asignados y disponibles.
     * @param {HTMLElement} checkbox - El checkbox que fue modificado.
     * @param {boolean} esAsignado - Indica si el usuario estaba en la lista de asignados.
     * @return {void}
     */
    const moverUsuarioApoyo = function (checkbox, esAsignado) {
        const $checkbox = jQuery(checkbox);
        const userId = $checkbox.val();
        const userName = $checkbox.data('nombre');
        const userDoc = $checkbox.data('documento');
        const userMail = $checkbox.data('mail');
        const isChecked = $checkbox.is(':checked');
      
        let listaOrigen, listaDestino, nuevoEstado;

        if (esAsignado) {
            listaOrigen = '#lista_usuarios_asignados';
            listaDestino = '#lista_usuarios_disponibles';
            nuevoEstado = false;
        } else {
            listaOrigen = '#lista_usuarios_disponibles';
            listaDestino = '#lista_usuarios_asignados';
            nuevoEstado = true;
        }

        if ((esAsignado && !isChecked) || (!esAsignado && isChecked)) {
            const checkboxId = 'usuario_' + userId + '_' + listaDestino.replace('#lista_usuarios_', '');
            const nuevoItem = [
                '<label class="list-group-item" for="' + checkboxId + '">',
                '    <input class="form-check-input me-2" type="checkbox" ',
                '           id="' + checkboxId + '" ',
                '           value="' + userId + '" ',
                '           data-nombre="' + userName + '" ',
                (nuevoEstado ? '       checked ' : ''),
                '           onchange="moverUsuarioApoyo(this, ' + nuevoEstado + ');">',
                '    <div>',
                '        <strong>' + userName + '</strong>',
                '    </div>',
                '</label>'
            ].join('');

            jQuery(listaDestino + ' .text-center').remove();

            jQuery(listaDestino).append(nuevoItem);

            $checkbox.closest('label').remove();

            if (jQuery(listaOrigen + ' label').length === 0) {
                const mensaje = esAsignado ? 'asignados' : 'disponibles';
                jQuery(listaOrigen).html(
                    '<div class="text-center py-4 text-muted">' +
                    '    <i class="fe fe-users fs-1"></i>' +
                    '    <p>No hay usuarios ' + mensaje + '</p>' +
                    '</div>'
                );
            }
        }
    };

    /**
     * Guarda las asignaciones de usuarios de apoyo para un supervisor.
     * Realiza las operaciones necesarias para agregar, reactivar o desactivar usuarios.
     * @return {void}
     */
    const guardarApoyoSupervisor = function () {
