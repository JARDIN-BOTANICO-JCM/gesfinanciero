		__TransportarData(
  			form_data,
  			function ( data ) {
  				const result = data['result'];
  				const datar = result['data'];
  				const resumen = datar['resumen'];
  				
  				const htmlNuevos = [];
  				const htmlErrs = [];
  				
  				for ( const key in resumen ) {
