            	        const itemls = 'item' + targettpd.val() + '' + key;
            	        let idl = "";
            	        let vlchk = ""; 
            	        if( _el === false){
            	        	idl = 'list' + targettpd.val() + '' + key;
            	        	vlchk = ut.b64EncodeUnicode( JSON.stringify( { "empleados_id":0,"tipodoc_id":targettpd.val(),"documento": key, "nombres" : "","registrado":false } ) );
            	        	
            				htmlErrs.push('	<li id="' + itemls + '" class="list-group-item list-group-item-danger ">');
            				htmlErrs.push('		<div>');
            				htmlErrs.push('			<input class="form-check-input me-1" type="checkbox" value="' + vlchk + '" id="' + idl + '" name="' + idl + '">');
            				htmlErrs.push('			<label class="form-check-label stretched-link" for="' + idl + '">' + tpdBuscado + ' - ' + key + '</label>');
            				htmlErrs.push('		</div>');
            				htmlErrs.push('		<small>');
            				htmlErrs.push('			El usuario <strong>no</strong> existe en la base de datos ni en el archivo bogdata');
            				htmlErrs.push('		</small>');
            				htmlErrs.push('	</li>');
            	        }
            	        else{
            	        	idl = 'list' + _el['tipodoc_id'] + '' + _el['documento'];
            	        	vlchk = ut.b64EncodeUnicode( JSON.stringify( _el ) );
            	        	
            	        	let mostrarnombre = _el['nombres'];
            	        	if( jQuery.trim( mostrarnombre ) == "" ){
            	        		mostrarnombre = '<span class="text-warning">(Sin datos registrados)</span>';
            	        	}
            	        	
            				htmlNuevos.push('	<li id="' + itemls + '" class="list-group-item">');
            				htmlNuevos.push('		<div>');
            				htmlNuevos.push('			<input class="form-check-input me-1" type="checkbox" value="' + vlchk + '" id="' + idl + '" name="' + idl + '">');
            				htmlNuevos.push('			<label class="form-check-label stretched-link" for="' + idl + '">' + mostrarnombre + '</label>');
            				htmlNuevos.push('		</div>');
            				
            				let txt = "";
            				let tpdRegistrado = "CC";
            				if( parseInt( _el['tipodoc_id'] ) !== parseInt( targettpd.val() ) ){
            					if ( Object.hasOwnProperty.call( TIPODOC_DOS_LETRAS_JS, _el['tipodoc_id'] ) ) {
