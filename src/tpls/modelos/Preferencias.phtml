<script type="application/javascript">
<?php // TODO: Tarea 153 - Se crea la clase ReglasClass que permita manejar los eventos desde el front ?>
const ReglasClass = function( ){
	const ls_json = <?php echo json_encode( $d_json ); ?>;
	
	let tableId = "tbInt" + ut.GetUUID();
	
	const self = this;
	
	self.obtenerCamposById = function( d ){
		let res = [];
		
		if ( Object.hasOwnProperty.call( ls_json, d ) ) {
    		res = ls_json[ d ];
		}
		
		return res;
	};
	
	self.obtenerTodosCampos = function(){
		return ls_json;
	};
	
	self.dibujarCampos = function( o ){
		const _o = jQuery( o );
		const dt = _o.data();
		
		const target = jQuery( dt["target"] );
		const selval = jQuery( dt["selval"] );
		const selnam = dt["name"] ;
		
		let mintxt = selnam;
		if( selnam.length > 35 ){
			mintxt = selnam.substr(0, 36) + '...';
		}
		
		selval.html( mintxt );
		
		const items = self.obtenerCamposById( dt['value'] );
		
		const defhtml = [];
		defhtml.push ( '<div class="draggable">' );
		defhtml.push ( items.join( '</div><div class="draggable">' ) );
		defhtml.push ( '</div>' );
		target.html( defhtml.join('') );
	};
	
	self.dibujarMaestra = function( d ){
		const data = d["data"];
		const target = jQuery( d['target'] );
		const html = [];
		
		html.push('<div class="list-group"> ');
		for (const ind in data ) {
        	if ( Object.hasOwnProperty.call( data, ind ) ) {
        		const _el = data[ ind ];
        		html.push('		<label class="list-group-item d-flex justify-content-start ">');
            	html.push('			<input data-id="' + _el['id'] + '" class="form-check-input me-1" type="checkbox" value="">');
            	html.push('			<div>');
            	html.push('				<h5 class="mb-0">' + _el['cod_interno'] + '</h5>' );
