<script type="application/javascript">
jQuery( document ).ready(function(){
	var drake = dragula([
        document.getElementById('fields'),
        document.getElementById('operators'),
        document.getElementById('values'),
        document.getElementById('expressionArea')
    ], {
        copy: function (el, source) {
        	return source.id !== 'expressionArea';
        },
        accepts: function (el, target) {
        	return target.id === 'expressionArea';
        },
        removeOnSpill: true
    });

    document.getElementById('valueInput').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            let val = e.target.value.trim();
            if ( val ) {
                let div = document.createElement('div');
                div.className = 'draggable';
                div.textContent = `"${val}"`;
                document.getElementById('values').appendChild(div);
                e.target.value = '';
            }
        }
    });

    document.getElementById('exportBtn').addEventListener('click', function() {
        let items = document.querySelectorAll('#expressionArea .draggable');
        let expression = Array.from(items).map(el => el.textContent).join(' ');
        document.getElementById('output').textContent = expression;
    });
});
</script>

