	const asignarValoresCampos = function( d ){
		const src = d['src'];
		const ref = d['ref'];
		let val = "";
		let id = 0;
		
        for (const key in src) {
    	    if (Object.hasOwnProperty.call( src, key ) ) {
    	        const _el = src[key];
    	        
    	        if( _el['ref'] == ref ){
    	        	val = _el['valor'];
    	        	id = _el['id'];
    	        }
    	        
	        }
		}
		
		return { 'file' : val , id : id };
	};
	
