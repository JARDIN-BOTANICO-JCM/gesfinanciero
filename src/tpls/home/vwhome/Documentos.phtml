	const reunirComentarios = function( d ){
		const grppcoms = [];
		
		const tipo = d['tipo'];
		const src = d['src'];
		
		if( tipo == 0 ){
			for (const key in src) {
        	    if (Object.hasOwnProperty.call( src, key ) ) {
        	        const _el = src[key];
        	        grppcoms.push( { 'id' : _el['id'], 'fecha' : _el['fecha'], 'usuarios' : _el['usuarios'], 'valor' : _el['valor'], 'tipo' : tipo } );
    	        }
            }
		}
		else{
			const paquetesrequ_id = src['id'];
    		const comentarios = d['comms'];
    		
    		if( src['paquetereqtipos_id'] == 6 ){
    			const fl = d['filename'];
    			for (const key in comentarios) {
            	    if (Object.hasOwnProperty.call( comentarios, key ) ) {
            	        const _el = comentarios[key];
            	        if( paquetesrequ_id == _el['paquetesrequ_id'] ){
            	        	const comfl = JSON.parse( _el['valor'] );
            	        	const rutafl = ut.b64DecodeUnicode( comfl['flid_id'] );
            	        	if( fl == rutafl ){
            	        		grppcoms.push( { 'id' : _el['id'], 'fecha': _el['fecha'], 'usuarios' : _el['usuarios'], 'valor' : comfl['valor'], 'tipo' : tipo } );
            	        	}
            	        }
        	        }
                }
    		}
    		else{
    		
			    for (const key in comentarios) {
            	    if (Object.hasOwnProperty.call( comentarios, key ) ) {
            	        const _el = comentarios[key];
            	        if( paquetesrequ_id == _el['paquetesrequ_id'] ){
            	        	grppcoms.push( { 'id' : _el['id'], 'fecha': _el['fecha'], 'usuarios' : _el['usuarios'], 'valor' : _el['valor'], 'tipo' : tipo } );
            	        }
        	        }
                }
    		
    		}
    		
		}
        
        return grppcoms;
	};
	
